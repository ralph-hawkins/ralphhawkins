{#- Set `hero: false` in front matter to drop the hero header and its scripts
   (pages like the notes list supply their own h1). The scripts are tied to
   the hero on purpose: auto-scroll.js would otherwise scroll to the first
   .date element it finds — on a listing page that's a list item's date, not
   a post date. -#}
<!DOCTYPE html>
{#- --color-overscroll tints the iOS rubber-band area with the post's colour,
   the same 20% mix the theme-color meta used to carry before the browser
   chrome was left to itself. -#}
<html lang="en"{% if tags and 'weeknotes' in tags %} data-blob-hue="{{ page.fileSlug | blobHue }}" style="--color-overscroll: {{ page.fileSlug | blobOverscroll }}"{% endif %}>
<head>
    {% include "head-common.njk" %}
    {%- if hero !== false %}
    <script src="/js/post-nav-arrow.js" defer></script>
    <script src="/js/auto-scroll.js" defer></script>
    {%- endif %}
    {#- Ctrl+Alt+G draws the poster's grid over it. Weeknotes only, because
       the poster is: nothing else on the site has a grid to show. -#}
    {%- if tags and 'weeknotes' in tags %}
    <script src="/js/grid.js" defer></script>
    {%- endif %}
</head>
<body>
  <a class="skip-link" href="#main">Skip to main content</a>
  {%- if hero !== false %}
  <header>
    <div class="container">
      {#- Masthead, not the document title — every page's h1 is its own
         subject (post title, list heading), since / redirects to the
         latest post and there is no homepage document. -#}
      <p class="hero-title">
        Ralph Hawkins
      </p>
      <p>
        I’m a service designer who works in the public sector,
        currently with NHS England helping people stay healthy.
      </p>
      {% if page.url.startsWith('/graphic-design/') %}
      <p>I also studied graphic design.</p>
      {% else %}
      <p>
        These are my week notes.
      </p>
      {% endif %}
    </div>
  </header>
  {%- endif %}
  <main id="main">
    {#- The rule between the hero and the post title, full width because it is
       main's own child rather than the container's — the post's other hrs stop
       at the column. Weeknotes only: 404.njk opens with a container-width hr
       of its own and /graphic-design/ opens on the gallery, so neither wants a
       second line above it. See main > hr in layout.css for the spacing. -#}
    {%- if tags and 'weeknotes' in tags %}
    <hr>
    {#- The article opens here rather than in post.njk because the poster has
       to be main's own child to reach full width, and the h1 it carries has to
       stay inside the article it titles. The body copy keeps its column. -#}
    <article class="post-article">
      {% include "post-poster.njk" %}
      <div class="container">
        {{ content | safe }}
      </div>
    </article>
    {%- else %}
    <div class="container">
      {{ content | safe }}
    </div>
    {%- endif %}
  </main>
    {% include "footer.njk" %}
</body>
</html>
