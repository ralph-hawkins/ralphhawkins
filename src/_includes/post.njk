---
layout: base
---

<article>
  {% set postNumber = collections.publicWeeknotes | getPostNumber(page) %}
  {% set postVersion = page.inputPath | postVersion %}
  <div class="post-header">
    <div class="date post-meta">
      {% if postNumber %}
        <p class="post-meta-count">Week note {{ postNumber }}</p>
      {% endif %}
      {# Publish date from git history, like the colophon; front-matter date
         is the fallback for drafts and uncommitted files. #}
      {% set headerDate = date %}
      {% if postVersion and postVersion.published %}
        {% set headerDate = postVersion.published %}
      {% endif %}
      <p class="post-meta-date">{{ headerDate | dateFormat }}</p>
    </div>
    <h1 class="page-title">{{ title }}</h1>
    {% if description %}
      <p class="post-description">{{ description }}</p>
    {% endif %}
  </div>
  <hr>
  <div class="post-content">
    {{ content | safe }}
  </div>
  <hr>
  {% if postVersion %}
    <details class="post-colophon">
      <summary>Colophon</summary>
      <dl>
      <dt>Version</dt>
      <dd>{{ postVersion.version }}{% if postVersion.draft %} (draft){% endif %}</dd>
      {% if postVersion.published %}
        <dt>Published</dt>
        <dd><time datetime="{{ postVersion.published | isoDate }}">{{ postVersion.published | dateTimeFormat }}</time></dd>
      {% endif %}
      {% if postVersion.updated %}
        <dt>Last updated</dt>
        <dd><time datetime="{{ postVersion.updated | isoDate }}">{{ postVersion.updated | dateTimeFormat }}</time></dd>
      {% endif %}
      </dl>
    </details>
  {% endif %}
</article>
