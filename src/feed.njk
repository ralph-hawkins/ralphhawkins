---
permalink: /feed.xml
eleventyExcludeFromCollections: true
---
{#- Atom feed of the most recent week notes, full text.

   Atom rather than RSS 2.0 because it distinguishes <published> from
   <updated>, which is exactly the pair post-versions.js already derives from
   git — so a post that gets revised resurfaces in readers that sort by
   update, and one that doesn't, doesn't.

   Every value goes through `| xmlEscape | safe`: xmlEscape escapes for XML,
   safe stops Nunjucks' HTML autoescaping doing it a second time. See
   src/_11ty/filters/feed.js. -#}
{%- set posts = collections.publicWeeknotes | reverse -%}
{%- set entries = posts.slice(0, 20) -%}
{%- set feedUpdated = entries | latestUpdate -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>Ralph Hawkins</title>
  <subtitle>Week notes on the work of designing public services</subtitle>
  <link rel="self" type="application/atom+xml" href="{{ site.url }}/feed.xml"/>
  <link rel="alternate" type="text/html" href="{{ site.url }}/"/>
  <id>{{ site.url }}/</id>
  <updated>{{ feedUpdated | isoDate }}</updated>
  <author>
    <name>Ralph Hawkins</name>
    <uri>{{ site.url }}</uri>
  </author>
{%- for post in entries %}
{%- set version = post.inputPath | postVersion %}
{%- set published = version.published if (version and version.published) else post.date %}
{%- set updated = version.updated if (version and version.updated) else published %}
  <entry>
    <title>{{ post.data.title | xmlEscape | safe }}</title>
    <link rel="alternate" type="text/html" href="{{ site.url }}{{ post.url }}"/>
    <id>{{ site.url }}{{ post.url }}</id>
    <published>{{ published | isoDate }}</published>
    <updated>{{ updated | isoDate }}</updated>
{%- if post.data.description %}
    <summary>{{ post.data.description | xmlEscape | safe }}</summary>
{%- endif %}
    <content type="html">{{ post.templateContent | absoluteUrls(site.url, post.url) | xmlEscape | safe }}</content>
  </entry>
{%- endfor %}
</feed>
